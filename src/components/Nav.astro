  <a href="/" class="shrink-0 text-lg font-bold tracking-[-.04em] sm:text-xl">iamohamed<span class="text-copper">.</span></a>
  <nav aria-label="Main navigation" class="flex flex-wrap items-center justify-end gap-x-3 gap-y-1 whitespace-nowrap text-xs font-semibold sm:gap-5 sm:text-sm md:gap-8">
    {home && <a href="#work" class="hidden sm:block">Work</a>}
    {home && <a href="#about" class="hidden sm:block">About</a>}
    <a href="https://github.com/mhyassin" target="_blank" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    <a href="https://gitlab.com/mhyassin" target="_blank" rel="me noreferrer">GitLab <span aria-hidden="true">↗</span></a>
    <a href="https://www.linkedin.com/in/mhyassin" target="_blank" rel="me noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
